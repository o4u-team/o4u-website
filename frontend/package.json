{
    "name": "o4u-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "scripts": {
        "dev": "tsx server/index.ts",
        "build": "npm run type-check && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr",
        "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
        "type-check": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check": "npm run lint && npm run format:check && npm run test && npm run build",
        "preview": "vite preview"
    },
    "dependencies": {
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "vuetify": "^3.11.8",
        "@mdi/font": "^7.4.47",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.4",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "prettier": "3.9.6",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.12",
        "vue-tsc": "^3.3.11",
        "tsx": "^4.20.6"
    }
}
