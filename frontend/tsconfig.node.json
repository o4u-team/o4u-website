{
    "compilerOptions": {
        "strict": true,
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": ["vite.config.ts", "vitest.config.ts", "server/**/*.ts"]
}
