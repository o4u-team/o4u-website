{
    "compilerOptions": {
        "strict": true,
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "types": ["node", "vite/client"],
        "rootDir": ".",
        "esModuleInterop": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true
    },
    "include": ["server/**/*.ts"]
}
