BIND_ADDRESS=127.0.0.1:8088
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional shared parent domain when SSR frontend and OAuth backend use sibling hosts.
SESSION_COOKIE_DOMAIN=
# Use DATABASE_URL or the existing DB_* credentials. Do not create a new database.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=o4u
DB_USERNAME=o4u
DB_PASSWORD=
# Only trust explicit reverse proxy addresses for X-Real-IP.
TRUSTED_PROXY_IPS=127.0.0.1,::1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
O4U_SECRET_KEY=
ODOO_TENANT_BASE_URL=
ODOO_TENANT_REGISTRATION_URL=
ODOO_TENANT_REGISTRATION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_BYPASS=false
# Inline service-account JSON (single quotes preserve JSON escapes), or an absolute file path.
FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"your-project","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
TELEGRAM_BOT_TOKEN=
TELEGRAM_REGISTRATION_CHAT_ID=
RUST_LOG=o4u_api=info,tower_http=info
